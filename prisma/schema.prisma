datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resumes         Resume[]
  jobDescriptions JobDescription[]
  analyses        Analysis[]
}

model Resume {
  id          String          @id @default(uuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String          @default("My Resume")
  rawText     String
  parsedData  Json            // Structured NormalizedResume JSON
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    ResumeVersion[]
  analyses    Analysis[]
}

model ResumeVersion {
  id             String   @id @default(uuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionNumber  Int
  matchScore     Int
  scoreBreakdown Json
  resumeData     Json
  changesSummary Json
  createdAt      DateTime @default(now())
}

model JobDescription {
  id          String     @id @default(uuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle   String
  company     String
  jobUrl      String?
  rawText     String
  parsedData  Json       // Structured JobAnalysis JSON
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  analyses    Analysis[]
}

model Analysis {
  id                 String         @id @default(uuid())
  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId           String
  resume             Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId              String
  jobDescription     JobDescription @relation(fields: [jobId], references: [id], onDelete: Cascade)
  versionNumber      Int            @default(1)
  overallScore       Int
  explainableSummary String
  scoreBreakdown     Json
  skills             Json
  gaps               Json
  keywords           Json
  resumeQuality      Json
  recommendations    Json
  createdAt          DateTime       @default(now())
}
